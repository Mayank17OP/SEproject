{
  "name": "timetable-to-calendar",
  "version": "1.0.0",
  "private": true,
  "description": "Turn a college timetable PDF or photo into a Google Calendar .ics with rooms, faculty and weekly recurrence.",
  "scripts": {
    "dev": "next dev --port 3000 --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --port 3000 --hostname 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "vendor": "node scripts/vendor-assets.mjs",
    "samples": "node scripts/make-samples.mjs",
    "postinstall": "node scripts/vendor-assets.mjs"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.100",
    "next": "^15.5.29",
    "pdfjs-dist": "^5.4.149",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@tesseract.js-data/eng": "^1.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "node-ical": "^0.27.6",
    "pdfkit": "^0.17.2",
    "postcss": "^8.5.33",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
